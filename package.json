{
  "name": "abc-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test:sales": "node tests/sales-money.test.cjs && node tests/sales-checkout.test.cjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run test:unit && npm run test:legacy",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:legacy": "node --test tests/*.test.cjs tests/*.test.mjs",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "check:dossier": "esbuild scripts/render-dossier-check.mjs --bundle --platform=node --format=esm --jsx=automatic --loader:.tsx=tsx --loader:.ts=ts --alias:@=./src --outfile=scripts/.dossier-check.bundle.mjs --external:@react-pdf/renderer && node scripts/.dossier-check.bundle.mjs"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.2.3",
    "@react-pdf/renderer": "^4.9.1",
    "@supabase/supabase-js": "^2.57.4",
    "@types/jsbarcode": "^3.11.4",
    "@zxing/library": "^0.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "react-toastify": "^11.2.0",
    "tailwind-merge": "^3.3.1",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.1.0"
  }
}
